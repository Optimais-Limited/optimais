# Supabase gives two pooled ports on the same pooler host: 6543 is the transaction-mode pooler
# (what the running app should use on serverless — DATABASE_URL here) and 5432 is the session-mode
# pooler (used only for `prisma db push`/migrate, which need a longer-lived connection — DIRECT_URL).
# Using 5432 for both (as this project's URLs are named) works but is more prone to exhausting the
# connection pool under concurrent serverless traffic; 6543 for DATABASE_URL fixed that in production.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:4173"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-this-before-seeding"
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-5.4-mini"
# Email delivery: set either RESEND_API_KEY, or the SMTP_* vars, for contact-form
# and password-reset emails to actually send (see lib/mailer.ts).
RESEND_API_KEY=""
RESEND_FROM="Optimais Labs <hello@optimaislabs.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="replace-with-a-real-gmail-app-password"
SMTP_FROM="Optimais Labs <you@gmail.com>"
CONTACT_TO_EMAIL="optimaislabs.com@gmail.com"
# Exhibitions media (photos/videos): a PRIVATE Cloudflare R2 bucket (S3-compatible). Create the
# bucket in the Cloudflare dashboard (R2 -> Create bucket -> do NOT enable public access), then
# an R2 API token (R2 -> Manage API tokens) for the Access Key ID / Secret. R2_ENDPOINT is your
# account's S3 endpoint, https://<account-id>.r2.cloudflarestorage.com. CLOUDFLARE_API_TOKEN is
# only used to manage bucket config (e.g. CORS) via the Cloudflare API, not for object access.
# Never expose R2_SECRET_ACCESS_KEY or CLOUDFLARE_API_TOKEN to the browser (see lib/storage.ts).
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="replace-with-an-r2-config-api-token"
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="replace-with-the-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-the-r2-secret-access-key"
R2_BUCKET="your-bucket-name"
# Discussions live voice: a LiveKit Cloud project (livekit.io). Copy these from your project's
# Settings -> Keys. Never expose LIVEKIT_API_SECRET to the browser (see lib/livekit.ts).
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="replace-with-the-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-the-livekit-api-secret"
